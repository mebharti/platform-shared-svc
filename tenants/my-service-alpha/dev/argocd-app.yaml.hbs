apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: tenant-{{ projectName }}-dev
  namespace: argocd
  annotations:
    argocd.argoproj.io/sync-wave: "1"
spec:
  project: default
  source:
    repoURL: 'https://github.com/org/platform-shared-svc.git'
    targetRevision: HEAD
    path: 'tenants/{{ projectName }}/dev'
  destination:
    server: 'https://kubernetes.default.svc'
    namespace: tenant-{{ projectName }}-dev
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
